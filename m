-    ptrdiff_t offset = tcg_ptr_byte_diff(target, src_rx) - 8;
-
-    if (offset >= -0xfff && offset <= 0xfff) {
-        tcg_insn_unit insn = *src_rw;
-        bool u = (offset >= 0);
-        if (!u) {
-            offset = -offset;
-        }
-        insn = deposit32(insn, 23, 1, u);
-        insn = deposit32(insn, 0, 12, offset);
-        *src_rw = insn;
-        return true;
