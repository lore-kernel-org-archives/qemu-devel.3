>      if ((val & FPSCR_RM_MASK) == FPSCR_RM_ZERO) {
> @@ -215,6 +215,11 @@ void helper_ld_fpscr(CPUSH4State *env, uint32_t val)
>      set_flush_to_zero((val & FPSCR_DN) != 0, &env->fp_status);
>  }
