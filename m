-            a2 = a0;
-        }
-        tcg_out_vreg3(s, INSN_VAND, q, 0, a0, a1, a2);
-        return;
-
-    case INDEX_op_orc_vec:
-        if (!const_args[2]) {
-            tcg_out_vreg3(s, INSN_VORN, q, 0, a0, a1, a2);
