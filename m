+            switch (bh_utf8_decode(&vc->utf8_state, &vc->utf8_codepoint, ch)) {
+            case BH_UTF8_ACCEPT:
+                vc_put_one(vc, unicode_to_cp437(vc->utf8_codepoint));
+                break;
+            case BH_UTF8_REJECT:
